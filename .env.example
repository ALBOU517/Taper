# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
POSTGRES_PASSWORD=taper
PUBLIC_URL=http://localhost:8000
# Optional — https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_VERIFY_TOKEN=taper-verify
# Free key from https://fdc.nal.usda.gov/api-key-signup — DEMO_KEY works but is heavily rate-limited
USDA_API_KEY=DEMO_KEY
# Open Food Facts asks apps to identify themselves; put an email or project URL
OFF_CONTACT=you@example.com
# 1 = show the three demo athletes on the sign-in page (portfolio demo); 0 for personal use
DEMO_MODE=0
# Where SQLite data, the login secret and daily backups live (absolute path recommended)
TAPER_DATA_DIR=~/.taper
